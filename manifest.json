{
  "manifest_version": 3,
  "name": "Social Media Moat",
  "version": "1.3.0",
  "description": "Filters X (Twitter) posts by the country each account is based in, so you can see only posts from your country.",
  "homepage_url": "https://github.com/jonpikereally/SocialMediaMoat",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Social Media Moat",
    "default_popup": "app/popup.html",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://mobile.x.com/*"],
      "js": ["src/page.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*", "https://mobile.x.com/*"],
      "js": ["src/shared/countries.js", "src/shared/rules.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "unlimitedStorage", "alarms"],
  "host_permissions": ["https://abs.twimg.com/*"]
}
